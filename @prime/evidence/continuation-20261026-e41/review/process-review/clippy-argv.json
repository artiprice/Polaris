[
  "cargo",
  "clippy",
  "--no-deps",
  "--all-targets",
  "-p",
  "polaris-platform-process",
  "--",
  "-D",
  "warnings",
  "-D",
  "clippy::unwrap_used",
  "-D",
  "clippy::expect_used",
  "-D",
  "clippy::panic",
  "-D",
  "clippy::indexing_slicing",
  "-D",
  "clippy::as_conversions",
  "-D",
  "clippy::arithmetic_side_effects"
]
