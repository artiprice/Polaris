expression: out
---
budget.usd               Env -
concurrency.disk         Defaults -
concurrency.docs         Defaults -
concurrency.inference    Defaults -
concurrency.s1           Defaults -
concurrency.sandbox      Defaults -
concurrency.web          Env -
log.level                Global ~/.polaris/config.toml
nebius.api_key           Global ~/.polaris/config.toml
nebius.base_url          Defaults -
nebius.effort.high       Defaults -
nebius.effort.low        Defaults -
nebius.effort.max        Defaults -
nebius.effort.medium     Defaults -
nebius.effort.xhigh      Defaults -
ratelimit.rpm            Repo .polaris/config.toml
ratelimit.tpm            Global ~/.polaris/config.toml
sandbox.tier             Session -
storage.level            Defaults -
ui.cli.ascii             Defaults -
ui.cli.color             Defaults -
ui.cli.color_depth       Defaults -
ui.cli.panel             Defaults -
ui.cli.reduce_motion     Defaults -
ui.cli.theme             Defaults -
ui.theme                 Repo .polaris/config.toml

PolarisConfig {
    ratelimit: RateLimitConfig {
        rpm: 20,
        tpm: 90000,
    },
    concurrency: ConcurrencyConfig {
        inference: 6,
        web: 12,
        docs: 16,
        disk: 64,
        s1: 3,
        sandbox: 4,
    },
    storage: StorageConfig {
        level: Global,
    },
    sandbox: SandboxConfig {
        tier: Contree,
    },
    nebius: NebiusConfig {
        base_url: "https://api.tokenfactory.nebius.com/v1/",
        api_key: Some(
            Keyring {
                service: "polaris",
                user: "nebius",
            },
        ),
        effort: EffortModels {
            low: ModelId(
                "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B",
            ),
            medium: ModelId(
                "nvidia/Nemotron-3_5-Lightning",
            ),
            high: ModelId(
                "nvidia/nemotron-3-super-120b-a12b",
            ),
            xhigh: ModelId(
                "nvidia/nemotron-3-super-120b-a12b",
            ),
            max: ModelId(
                "nvidia/Nemotron-3-Ultra-550b-a55b",
            ),
        },
    },
    search: SearchConfig {
        tavily_api_key: None,
        searxng_url: None,
    },
    log: LogConfig {
        level: Warn,
    },
    budget: BudgetConfig {
        usd: Some(
            "5",
        ),
        tokens: None,
    },
    ui: UiConfig {
        theme: Light,
        cli: CliPreferences {
            theme: Dark,
            color: Auto,
            color_depth: Auto,
            ascii: false,
            reduce_motion: false,
            panel: Closed,
        },
    },
