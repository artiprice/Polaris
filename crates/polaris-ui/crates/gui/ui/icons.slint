    out property <string> plus: "M12 5v14M5 12h14";
    out property <string> chat: "M20 11.5a7.5 7.5 0 0 1-7.5 7.5H5l-3 3V11.5A7.5 7.5 0 0 1 9.5 4h3A7.5 7.5 0 0 1 20 11.5Z M7 10h8M7 14h5";
