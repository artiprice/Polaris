    out property <string> branch: "M6 3v12 M18 3a3 3 0 1 1 0 6a3 3 0 1 1 0-6Z M6 15a3 3 0 1 1 0 6a3 3 0 1 1 0-6Z M18 9a9 9 0 0 1-9 9";
    out property <string> info: "M12 3a9 9 0 1 1 0 18a9 9 0 1 1 0-18Z M12 11v5 M12 8h.01";
