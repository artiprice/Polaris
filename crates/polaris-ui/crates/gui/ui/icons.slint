// One stroke icon. The stroke keeps the demo's 1.45 units of a 24-unit box at any size.
export component Icon {
    in property <string> commands;
    in property <brush> color;
    width: 18px;
    height: 18px;
    Path {
        width: parent.width;
        height: parent.height;
        commands: root.commands;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.color;
        stroke-width: 1.45px * (root.width / 24px);
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}
