    out property <string> settings: "M4 7h4m4 0h8M4 17h8m4 0h4 M12 7a2 2 0 1 1-4 0a2 2 0 1 1 4 0Z M16 17a2 2 0 1 1-4 0a2 2 0 1 1 4 0Z";
    out property <string> sparkle: "M12 3l2.5 6.5L21 12l-6.5 2.5L12 21l-2.5-6.5L3 12l6.5-2.5L12 3Z";
