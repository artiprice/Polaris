!/tests/fixtures/**/*.log

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Runtime and session data (Claude Code config layout).
# Anchored to the repository root so that crate directories with the same names
# (e.g. crates/*/src/sessions, crates/polaris-storage/crates/cache, src/bin) are tracked.
/sessions/
/backups/
/chrome/
/shell-snapshots/
/todos/
/statsig/
/docs/
/projects/
/ide/
/plans/
/plugins/cache/

# Local development
/local/
*.local
.claude/settings.local.json

# Node modules if any
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

/history.jsonl
/file-history/
/.statusline_cache/
/plugins/
/stats-cache.json
/plugins/installed_plugins.json
/bin/
tmpclaude-*
/plugins/known_marketplaces.json
/paste-cache/
/tasks/
/teams/
/cache/
/parallel-phases/
tests/last-results.xml
tests/debug-unicode.ps1
/statusline
.last-cleanup
settings.local.json
mcp-needs-auth-cache.json
# Root-level lock files stay ignored, except Cargo.lock: Polaris ships binaries,
# so the lockfile is committed for reproducible builds.
/*.lock
!/Cargo.lock
/jobs
/daemon
/.last-update-result.json
/daemon.status.json
/agent-memory
