//! Generated workload for /ci-run (P8): enough code that a cold build takes measurable time,
//! so the cached second run shows the cache. Regenerate by hand; no build script.

/// Generated function 0.
#[must_use]
pub fn work_0(values: &[u64]) -> u64 {
    values
        .iter()
        .map(|v| v.wrapping_mul(3).rotate_left(1))
        .filter(|v| v % 2 != 0)
        .fold(0_u64, |acc, v| acc.wrapping_add(v) ^ (acc >> 3))
}

