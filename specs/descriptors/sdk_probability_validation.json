  "dependencies": ["polaris_sdk::error::ParseError"],
  "libraries": ["serde", "serde_json (dev)"],
  "inputs": [ { "name": "value", "type": "f32", "description": "Candidate probability." } ],
  "output_type": "Result<Probability, ParseError>",
