    },
    {
      "test_name": "json_line_wraps_the_fields_object",
      "description": "JSON line is `{ts,level,target,fields:<object>}` with the fields object embedded verbatim."
    },
    {
      "test_name": "json_line_escapes_the_target",
      "description": "Quotes, backslashes and control characters in the target are escaped."
    }
  ],
