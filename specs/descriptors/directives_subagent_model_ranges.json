{
  "type_of": "function",
  "name": "parse_model_efforts",
  "file_path": "crates/polaris-kernel/crates/directives/src/effort.rs",
  "logic_name": "Subagent Model Ranges",
  "test_list": [
    {
      "test_name": "named_and_numeric_efforts_are_equal",
      "description": "`nano(1-3)` equals `nano(low-high)`."
    },
    {
      "test_name": "single_effort_means_lo_equals_hi",
      "description": "`nano(medium)` has lo = hi = Medium."
    },
    {
      "test_name": "mixed_forms_parse",
      "description": "`nano(1-medium)` and `nano(1 - 3)` parse."
    },
    {
      "test_name": "reversed_range_is_rejected",
      "description": "`nano(high-low)` fails with BadEffortRange."
    },
    {
      "test_name": "nested_parens_do_not_leak_between_entries",
      "description": "`a(1-2), b(4-5)` yields two independent entries."
    },
    {
      "test_name": "quoted_model_id_with_slash_parses",
      "description": "`\"nvidia/nemotron-3-super-120b-a12b\"(high-max)` and unquoted `nvidia/x(2)` parse."
    },
    {
      "test_name": "subagent_models_directive_end_to_end",
      "description": "`$subagent-models(...)` through parse() yields SubagentModels."
    }
  ],
  "dependencies": [
    "polaris_sdk::effort::Effort",
    "polaris_sdk::ids::{SessionId, ShortRef}"
  ],
  "libraries": [
    "thiserror",
    "proptest (dev)"
  ],
  "inputs": [
    {
      "name": "args",
      "type": "&str",
      "description": "Inside of `$subagent-models(...)`."
    }
  ],
  "output_type": "Result<Vec<ModelEffort>, DirectiveError>",
  "output_description": "Model ids with effort ranges (sdk Effort)."
}
