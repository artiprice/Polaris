{
  "type_of": "struct",
  "name": "IgnoreRules",
  "file_path": "crates/polaris-storage/crates/sync/src/ignore.rs",
  "logic_name": "Ignore And Deny Rules",
  "test_list": [
    {
      "test_name": "polarisignore_excludes_matches",
      "description": "Patterns in .polarisignore (gitignore syntax) exclude matching files."
    },
    {
      "test_name": "deny_list_defaults_present",
      "description": ".env, .env.local, *.pem, *.key, .git/config, .ssh/*, id_rsa, *.pfx are denied by default."
    },
    {
      "test_name": "negation_cannot_reinclude_denied",
      "description": "'!.env' in .polarisignore does not re-include a denied file."
    },
    {
      "test_name": "git_metadata_denied",
      "description": ".git metadata is denied at any depth, including a linked-worktree .git file."
    },
    {
      "test_name": "git_and_polaris_metadata_are_denied_even_with_negation",
      "description": ".git and .polaris trees remain denied regardless of negation rules and path case."
    },
    {
      "test_name": "workspace_ignore_file_is_bounded_before_pattern_parsing",
      "description": "An oversized workspace ignore file is rejected before parsing patterns."
    },
    {
      "test_name": "ignored_directory_prunes_children",
      "description": "An ignored directory excludes everything below it."
    }
  ],
  "dependencies": [
    "polaris_sdk::ids::Cid",
    "polaris_sdk::registry::{SandboxBackend, SandboxHandle, ExecRequest, SandboxError}"
  ],
  "libraries": [
    "blake3",
    "walkdir",
    "ignore (gitignore matcher)",
    "globset",
    "futures",
    "thiserror",
    "tokio (dev)",
    "proptest (dev)",
    "tempfile (dev)"
  ],
  "inputs": [
    {
      "name": "root",
      "type": "&Path",
      "description": "Workspace root."
    },
    {
      "name": "polarisignore",
      "type": "Option<&str>",
      "description": "Contents of .polarisignore."
    }
  ],
  "output_type": "Exclusion",
  "output_description": "Included, Ignored or Denied (deny evaluated last, non-overridable)."
}
